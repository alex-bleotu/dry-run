{
  "name": "dry-run",
  "productName": "Dry Run",
  "description": "Timed C++ coding interview practice with hidden tests, in a desktop app.",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "alex-bleotu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-bleotu/dry-run.git"
  },
  "main": "main.js",
  "desktopName": "dry-run.desktop",
  "scripts": {
    "build:web": "node tools/build-web.js",
    "check": "node tools/check.js",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "generate-tests": "node tools/generate-all.js",
    "manifest": "node tools/build-manifest.js",
    "preview:web": "node tools/serve-web.js",
    "start": "electron . --no-sandbox"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@yowasp/clang": "21.1.4-3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.alexbleotu.dryrun",
    "productName": "Dry Run",
    "directories": {
      "output": "dist"
    },
    "files": [
      "judge.js",
      "main.js",
      "preload.js",
      "runner.js",
      "icon.png",
      "renderer/**/*",
      "problems/**/*",
      "!problems/**/solution.cpp",
      "node_modules/@fontsource-variable/inter/files/inter-latin-*wght-normal.woff2",
      "node_modules/@fontsource-variable/inter/LICENSE",
      "node_modules/@fontsource-variable/inter/package.json",
      "node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-*wght-normal.woff2",
      "node_modules/@fontsource-variable/jetbrains-mono/LICENSE",
      "node_modules/@fontsource-variable/jetbrains-mono/package.json",
      "node_modules/marked/lib/marked.umd.js",
      "node_modules/marked/package.json",
      "node_modules/monaco-editor/min/**/*",
      "node_modules/monaco-editor/package.json",
      "!**/node_modules/monaco-editor/{dev,esm,min-maps}/**",
      "!**/node_modules/marked/{bin,man}/**",
      "!**/node_modules/@fontsource-variable/*/{scss/**,*.css,*.ts,metadata.json,unicode.json}",
      "!**/node_modules/@fontsource-variable/*/files/*-{cyrillic,cyrillic-ext,greek,greek-ext,vietnamese}-*",
      "!**/node_modules/@fontsource-variable/*/files/*-{italic,opsz-normal,standard-normal}.woff2",
      "!**/*.map",
      "!**/node_modules/dompurify/src/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "icon.png",
      "artifactName": "dry-run-${version}-linux.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png",
      "artifactName": "dry-run-${version}-windows-setup.${ext}"
    }
  }
}
